# video-export-stark — environment template
# Copy to .env if you prefer env vars over MCP-authenticated tokens.
# Default flow uses MCP servers (no tokens needed here).

# Override cache directory (default: %USERPROFILE%\.stark-video-export)
# STARK_VIDEO_EXPORT_CACHE_DIR=

# Override pasta-raiz dos vídeos (overrides config.json)
# STARK_VIDEO_EXPORT_VIDEO_ROOT=

# Logging level: debug | info | warn | error
STARK_VIDEO_EXPORT_LOG_LEVEL=info
